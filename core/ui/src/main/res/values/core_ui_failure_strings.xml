    <string name="core_ui_failure_permission_denied_title">접근할 수 없어요</string>
    <string name="core_ui_failure_permission_denied_description">이 내용을 볼 권한이 없어요</string>

    <!-- RESOURCE_NOT_FOUND · POSTING_NOT_FOUND (404) -->
    <string name="core_ui_failure_not_found_title">찾을 수 없어요</string>
    <string name="core_ui_failure_not_found_description">이미 지워졌거나 주소가 바뀐 것 같아요</string>
    <string name="core_ui_failure_not_found_posting_title">공고를 찾을 수 없어요</string>
    <string name="core_ui_failure_not_found_posting_description">삭제됐거나 마감돼 내려간 공고예요</string>
