-->
<resources>
    <!-- 한 줄로 말해야 하는 자리(스낵바)에서 제목과 본문을 잇는 형식. -->
    <string name="core_ui_failure_sentence">%1$s. %2$s</string>

    <!-- 행동 버튼 문구. 「없음」에는 버튼이 붙지 않으므로 문구도 없다. -->
    <string name="core_ui_failure_action_complete_profile">프로필 입력하기</string>
    <string name="core_ui_failure_action_free_up_space">정리하러 가기</string>
    <string name="core_ui_failure_action_sign_in">다시 로그인</string>

    <!-- 코드 없는 실패 · 우리가 먼저 끊음 (CoreDataFailure.NetworkUnavailable.isTimeout) -->
    <string name="core_ui_failure_timeout_title">응답이 너무 늦어요</string>
    <string name="core_ui_failure_timeout_description">기다리는 동안 답이 오지 않았어요. 잠시 후 다시 시도해 주세요</string>

    <!-- INVALID_INPUT (400) -->
    <string name="core_ui_failure_invalid_input_title">입력한 내용을 확인해 주세요</string>
    <string name="core_ui_failure_invalid_input_description">형식에 맞지 않는 값이 있어요. 고쳐서 다시 보내 주세요</string>

