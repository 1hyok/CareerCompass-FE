    <string name="core_ui_failure_unexpected_title">문제가 생겼어요</string>
    <string name="core_ui_failure_unexpected_description">잠시 후 다시 시도해 주세요</string>
    <string name="core_ui_failure_unexpected_posting_title">공고를 불러오지 못했어요</string>
    <string name="core_ui_failure_unexpected_board_title">게시판을 불러오지 못했어요</string>
    <string name="core_ui_failure_unexpected_experience_title">경험 카드를 불러오지 못했어요</string>
    <string name="core_ui_failure_unexpected_application_title">지원서를 불러오지 못했어요</string>
</resources>
