    <string name="core_ui_failure_parsing_failed_title">공고를 읽지 못했어요</string>
    <string name="core_ui_failure_parsing_failed_description">원문 형식을 알아보지 못했어요. 원문 보기로 확인해 주세요</string>

    <!-- BOARD_BLOCKED (422) -->
    <string name="core_ui_failure_board_blocked_title">자동 수집이 허용되지 않는 사이트예요</string>
    <string name="core_ui_failure_board_blocked_description">사이트가 수집을 막아 두었어요. 다른 게시판 주소로 등록해 주세요</string>

    <!-- RATE_LIMITED (429) -->
    <string name="core_ui_failure_rate_limited_title">요청이 너무 많아요</string>
    <string name="core_ui_failure_rate_limited_description">잠시 후 다시 시도해 주세요</string>

    <!-- LLM_UNAVAILABLE (503) -->
    <string name="core_ui_failure_service_unavailable_title">서비스가 잠시 점검 중이에요</string>
    <string name="core_ui_failure_service_unavailable_description">AI 분석 서버를 손보고 있어요.\n조금 뒤에 다시 열어 주세요</string>

