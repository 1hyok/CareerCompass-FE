<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      광고 SDK 미사용 — Analytics 는 Crashlytics breadcrumb 목적뿐이므로,
      firebase-analytics(play-services-measurement)가 병합해 오는 광고 ID 권한을 제거한다.
      https://developer.android.com/build/manage-manifests#node_markers
    -->
    <uses-permission
            android:name="com.google.android.gms.permission.AD_ID"
            tools:node="remove" />
    <uses-permission
            android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
            tools:node="remove" />

    <application
            android:name=".GlobalApplication"
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.CareerCompassfe.Main"
            android:usesCleartextTraffic="false">
        <meta-data
                android:name="google_analytics_adid_collection_enabled"
                android:value="false" />
        <meta-data
                android:name="google_analytics_default_allow_ad_personalization_signals"
                android:value="false" />
        <!-- 사용자 동의 흐름이 구현될 때까지 식별자·토큰 수집을 자동으로 시작하지 않는다. -->
        <meta-data
                android:name="firebase_analytics_collection_enabled"
                android:value="false" />
        <meta-data
                android:name="firebase_messaging_auto_init_enabled"
                android:value="false" />

        <!--
          현재 화면은 폰 세로 레이아웃만 지원한다. Android 16 대화면에서는 시스템이
          이 제한을 무시하므로 대화면 대응을 대신하는 선언은 아니다.
        -->
        <!-- App Startup — 기동 초기화는 Initializer 단위로 등록한다(Application.onCreate 비움). -->
        <provider
                android:name="androidx.startup.InitializationProvider"
                android:authorities="${applicationId}.androidx-startup"
                android:exported="false"
                tools:node="merge">
            <meta-data
                    android:name="com.cambridge.careercompass_fe.startup.KakaoInitializer"
                    android:value="androidx.startup" />
        </provider>

        <!--
          카카오 OAuth redirect(kakao{NATIVE_APP_KEY}://oauth) 핸들러 — SDK 계정 로그인이 브라우저에서 돌아오는 관문.

          tools:ignore="Instantiatable" 는 lint 오탐이다. Kakao SDK 2.24.0 부터 lint 가 이 클래스가
          android.app.Activity 를 상속하지 않는다고 보고하지만 aar 안의 계층은 그대로다
          (AuthCodeHandlerActivity -> CustomTabLauncherActivity -> androidx.appcompat.app.AppCompatActivity).
          2.24.0 이 Gradle Module Metadata 로 aar variant 만 노출하면서 lint 의 상위 클래스 해석이 끊긴 것이고,
          appcompat 은 런타임 클래스패스에 정상 리졸브된다. 억제는 이 컴포넌트 한 곳에만 건다 — 규칙 자체를
          끄면 진짜 Instantiatable 회귀를 놓친다.
        -->
        <activity
                android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
                android:exported="true"
                tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                        android:host="oauth"
                        android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>

        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:icon="@mipmap/ic_launcher"
                android:roundIcon="@mipmap/ic_launcher_round"
                android:screenOrientation="portrait"
                android:theme="@style/Theme.CareerCompassfe.Starting"
                tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
